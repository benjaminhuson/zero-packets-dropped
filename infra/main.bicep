// Stride PoC infrastructure. Deploy into the team's own resource group only:
//   az deployment group create -g <resource-group> -f infra/main.bicep -p teamNumber=NN ...
// infra/deploy.sh runs this for you. Nothing secret lives in this file.
//
// What it creates (about £10 a month, mostly the B1 plan):
//   asp-teamNN-stride            App Service plan, Linux B1
//   app-teamNN-stride-<suffix>   Web app: serves the Stride front end and the API on one origin
//   cosmos-teamNN-stride-<sfx>   Cosmos DB, serverless, keys turned off (managed identity only)
// plus Microsoft sign-in (App Service authentication) once entraClientId is passed in.

@description('Two-digit team number, for example 03.')
@minLength(2)
@maxLength(2)
param teamNumber string

@description('UK South or Italy North only (hackathon rule).')
@allowed(['uksouth', 'italynorth'])
param location string = 'uksouth'

@description('Client (application) id of the teamNN-stride app registration. Leave empty on the first run.')
param entraClientId string = ''

@description('Signs the Stride session cookie for new colleagues. Generated by deploy.sh; keep it stable between runs.')
@secure()
param sessionSecret string

@description('Protects POST /api/admin/catch-up. Generated by deploy.sh.')
@secure()
param adminToken string

@description('Object id of the person running the deployment, so they can load demo data into Cosmos DB. Optional.')
param deployerPrincipalId string = ''

var team = 'team${teamNumber}'
var suffix = take(uniqueString(resourceGroup().id, 'stride'), 4)
var tags = { team: team, event: 'hackathon', app: 'stride' }
var authEnabled = !empty(entraClientId)

// Keep in step with backend/src/store/cosmos.ts (CONTAINERS).
var containers = [
  { name: 'journeys', key: '/userId' }
  { name: 'messages', key: '/userId' }
  { name: 'checkIns', key: '/userId' }
  { name: 'chat', key: '/userId' }
  { name: 'starters', key: '/id' }
  { name: 'starterState', key: '/userId' }
  { name: 'notes', key: '/starterId' }
]

// ---- Data -------------------------------------------------------------------

resource cosmos 'Microsoft.DocumentDB/databaseAccounts@2024-05-15' = {
  name: 'cosmos-${team}-stride-${suffix}'
  location: location
  tags: tags
  kind: 'GlobalDocumentDB'
  properties: {
    databaseAccountOfferType: 'Standard'
    locations: [{ locationName: location, failoverPriority: 0, isZoneRedundant: false }]
    capabilities: [{ name: 'EnableServerless' }]
    consistencyPolicy: { defaultConsistencyLevel: 'Session' }
    disableLocalAuth: true // no keys or connection strings: Entra (managed identity) only
    minimalTlsVersion: 'Tls12'
  }
}

resource db 'Microsoft.DocumentDB/databaseAccounts/sqlDatabases@2024-05-15' = {
  parent: cosmos
  name: 'stride'
  properties: { resource: { id: 'stride' } }
}

resource dbContainers 'Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers@2024-05-15' = [for c in containers: {
  parent: db
  name: c.name
  properties: {
    resource: {
      id: c.name
      partitionKey: { paths: [c.key], kind: 'Hash' }
    }
  }
}]

// ---- Hosting ----------------------------------------------------------------

resource plan 'Microsoft.Web/serverfarms@2023-12-01' = {
  name: 'asp-${team}-stride'
  location: location
  tags: tags
  kind: 'linux'
  sku: { name: 'B1', tier: 'Basic' }
  properties: { reserved: true }
}

resource app 'Microsoft.Web/sites@2023-12-01' = {
  name: 'app-${team}-stride-${suffix}'
  location: location
  tags: tags
  kind: 'app,linux'
  identity: { type: 'SystemAssigned' }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    siteConfig: {
      linuxFxVersion: 'NODE|20-lts'
      appCommandLine: 'node dist/server.js'
      alwaysOn: true // keeps the daily reminder job alive
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      http20Enabled: true
      healthCheckPath: '/api/health'
      appSettings: [
        { name: 'AUTH', value: 'easyauth' }
        { name: 'STORE', value: 'cosmos' }
        { name: 'AGENT', value: 'rules' }
        { name: 'TEAMS', value: 'mock' }
        { name: 'SCHEDULER', value: 'on' }
        { name: 'STATIC_DIR', value: 'public' }
        { name: 'AZURE_COSMOS_ENDPOINT', value: cosmos.properties.documentEndpoint }
        { name: 'AZURE_COSMOS_DATABASE', value: 'stride' }
        { name: 'SESSION_SECRET', value: sessionSecret }
        { name: 'ADMIN_TOKEN', value: adminToken }
        { name: 'SCM_DO_BUILD_DURING_DEPLOYMENT', value: 'false' } // we deploy a ready-built package
        { name: 'WEBSITE_HEALTHCHECK_MAXPINGFAILURES', value: '10' }
      ]
    }
  }
}

// Microsoft sign-in for line managers, buddies and linked colleagues.
// Anonymous requests are allowed through, because new colleagues sign in with Stride before they have
// Entra ID; the backend decides what each caller may do. No client secret: ID tokens only.
resource auth 'Microsoft.Web/sites/config@2023-12-01' = if (authEnabled) {
  parent: app
  name: 'authsettingsV2'
  properties: {
    platform: { enabled: true }
    globalValidation: {
      requireAuthentication: false
      unauthenticatedClientAction: 'AllowAnonymous'
    }
    httpSettings: { requireHttps: true }
    identityProviders: {
      azureActiveDirectory: {
        enabled: true
        registration: {
          clientId: entraClientId
          openIdIssuer: '${environment().authentication.loginEndpoint}${tenant().tenantId}/v2.0'
        }
        validation: { allowedAudiences: [entraClientId, 'api://${entraClientId}'] }
      }
    }
    login: {
      tokenStore: { enabled: true }
      allowedExternalRedirectUrls: []
    }
  }
}

// ---- Access: the web app's managed identity can read and write Cosmos data ----------

var cosmosDataContributor = '00000000-0000-0000-0000-000000000002' // Cosmos DB Built-in Data Contributor

resource appData 'Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments@2024-05-15' = {
  parent: cosmos
  name: guid(cosmos.id, app.id, cosmosDataContributor)
  properties: {
    roleDefinitionId: '${cosmos.id}/sqlRoleDefinitions/${cosmosDataContributor}'
    principalId: app.identity.principalId
    scope: cosmos.id
  }
}

resource deployerData 'Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments@2024-05-15' = if (!empty(deployerPrincipalId)) {
  parent: cosmos
  name: guid(cosmos.id, deployerPrincipalId, cosmosDataContributor)
  properties: {
    roleDefinitionId: '${cosmos.id}/sqlRoleDefinitions/${cosmosDataContributor}'
    principalId: deployerPrincipalId
    scope: cosmos.id
  }
}

output webAppName string = app.name
output hostName string = app.properties.defaultHostName
output cosmosEndpoint string = cosmos.properties.documentEndpoint
output cosmosAccountName string = cosmos.name
